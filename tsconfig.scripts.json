{
  "comment": "Skrip build berjalan di Node, bukan React Native \u2014 tipenya dipisah supaya global Node tidak bocor ke kode aplikasi.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "scripts/**/*.ts",
    "lib/__tests__/**/*.ts"
  ]
}
